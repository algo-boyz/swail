<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="swail"
        Arguments=""
        InstallLocation="C:\Program Files\AlgoBoyz\Swail">
    </Installer>
    <PackageInformation
        PackageName="Swail"
        PackageDisplayName="Swail"
        PublisherName="CN=AlgoBoyz"
        PublisherDisplayName="AlgoBoyz"
        Version="0.1.0.0"
        PackageDescription="A swail application">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.example.mywailsapp"
                Description="A swail application"
                DisplayName="Swail"
                ExecutableName="swail"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Swail</DisplayName>
            <PublisherDisplayName>AlgoBoyz</PublisherDisplayName>
            <Description>A swail application</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="swail.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
